        "jsCode": "// Read the extracted text from the previous node\nconst rawText = $input.item.json.data || \"\";\nconst fileName = $node[\"Download file\"].json.name || \"return_policy.txt\";\n\n// Define chunk parameters\nconst chunkSize = 500;\nconst overlap = 50;\nconst chunks = [];\n\nfor (let i = 0; i < rawText.length; i += chunkSize - overlap) {\n    const textChunk = rawText.slice(i, i + chunkSize);\n    if (textChunk.trim().length > 0) {\n        chunks.push({\n            json: {\n                document_name: fileName,\n                category: \"policy\",\n                content: textChunk\n            }\n        });\n    }\n}\n\nreturn chunks;"
